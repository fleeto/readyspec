{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyspec.dev/schemas/template.v1.json",
  "title": "ReadySpec Template Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "version",
    "name_zh",
    "name_en",
    "domain_code",
    "group_code",
    "source",
    "maturity",
    "privilege_group",
    "evidence_depth",
    "kind"
  ],
  "properties": {
    "schema_version": { "const": "readyspec.template/v1" },
    "template_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "name_zh": { "type": "string", "minLength": 1 },
    "name_en": { "type": "string", "minLength": 1 },
    "domain_code": { "type": "string", "minLength": 1 },
    "group_code": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": { "enum": ["BUILTIN", "USER_PUBLIC", "PLAN_LOCAL"] },
    "maturity": { "enum": ["PLANNED", "DEFINED", "IMPLEMENTED", "INTEGRATED"] },
    "privilege_group": { "enum": ["STANDARD", "PRIVILEGED"] },
    "evidence_depth": {
      "enum": [
        "EXISTENCE",
        "METADATA",
        "CONFIGURATION",
        "EFFECTIVE_STATE",
        "STATIC_COMPATIBILITY",
        "ACTIVE_PROBE",
        "HISTORICAL_EVIDENCE",
        "CONTROL_AGGREGATE"
      ]
    },
    "kind": { "enum": ["NATIVE", "SHELL", "FLAT", "CONTROL", "CUSTOM_SHELL"] },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "conditional_notes": { "type": "string" },
    "active_network_probe": { "type": "boolean" },
    "parameters": { "type": "array", "items": { "type": "object" } },
    "shell_spec": { "type": ["object", "null"] },
    "digest": { "type": ["string", "null"] }
  }
}
