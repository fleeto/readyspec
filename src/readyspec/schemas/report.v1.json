{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyspec.dev/schemas/report.v1.json",
  "title": "ReadySpec Run Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "execution_backend",
    "plan_id",
    "plan_version",
    "plan_state",
    "plan_digest",
    "run_scope",
    "run_status",
    "readiness",
    "gate_eligible",
    "created_at",
    "finished_at",
    "hosts",
    "control_checks",
    "cleanup_records",
    "audit"
  ],
  "properties": {
    "schema_version": { "const": "readyspec.report/v1" },
    "run_id": { "type": "string" },
    "execution_backend": { "enum": ["mock_simulator", "openssh_goss"] },
    "platform_verified_claim": { "const": false },
    "plan_id": { "type": "string" },
    "plan_name": { "type": "string" },
    "plan_version": { "type": "string" },
    "plan_state": { "enum": ["TRIAL_SNAPSHOT", "RELEASED"] },
    "plan_digest": { "type": "string" },
    "run_scope": { "enum": ["FULL", "PARTIAL_SCOPE"] },
    "run_status": { "enum": ["PENDING", "RUNNING", "CANCELLING", "COMPLETED", "PARTIAL", "FAILED", "CANCELLED"] },
    "readiness": { "enum": ["READY", "NOT_READY", "UNKNOWN"] },
    "readiness_reason": { "type": "string" },
    "gate_eligible": { "type": "boolean" },
    "created_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] },
    "hosts": { "type": "array", "items": { "type": "object" } },
    "control_checks": { "type": "array", "items": { "type": "object" } },
    "cleanup_records": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "array", "items": { "type": "object" } },
    "audit": { "type": "object" }
  }
}
