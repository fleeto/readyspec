{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid":"PrepareImagesOnlyFromSessionSources","Effect":"Allow","Action":["ec2:CreateImage","ec2:CreateSnapshot"],"Resource":["arn:aws:ec2:us-east-1:891376991548:instance/*","arn:aws:ec2:us-east-1:891376991548:volume/*"],"Condition":{"StringEquals":{"ec2:ResourceTag/Project":"readyspec-m4","ec2:ResourceTag/Session":"d6b321143e61d7bf2a6c6b5f"}}},
    {"Sid":"CreateTaggedImagesAndSnapshots","Effect":"Allow","Action":["ec2:CreateImage","ec2:CreateSnapshot"],"Resource":["arn:aws:ec2:us-east-1::image/*","arn:aws:ec2:us-east-1::snapshot/*"],"Condition":{"StringEquals":{"aws:RequestTag/Project":"readyspec-m4","aws:RequestTag/Session":"d6b321143e61d7bf2a6c6b5f"}}},
    {"Sid":"UsePublicPublisherImages","Effect":"Allow","Action":"ec2:RunInstances","Resource":["arn:aws:ec2:us-east-1::image/ami-0d6dd9e8265d48906","arn:aws:ec2:us-east-1::image/ami-09a93d801db0bafae","arn:aws:ec2:us-east-1::image/ami-0412e376e50785f2a","arn:aws:ec2:us-east-1::image/ami-0d312ec202547c16c","arn:aws:ec2:us-east-1::image/ami-07f1ef003bc5de2b1","arn:aws:ec2:us-east-1::image/ami-07e6c22e0dbbc9683"],"Condition":{"StringEquals":{"ec2:RootDeviceType":"ebs","ec2:ImageType":"machine"},"Bool":{"ec2:Public":"true"}}},
    {"Sid":"UseOwnedSessionImagesAndSnapshots","Effect":"Allow","Action":"ec2:RunInstances","Resource":["arn:aws:ec2:us-east-1::image/*","arn:aws:ec2:us-east-1::snapshot/*"],"Condition":{"StringEquals":{"ec2:Owner":"891376991548","ec2:ResourceTag/Project":"readyspec-m4","ec2:ResourceTag/Session":"d6b321143e61d7bf2a6c6b5f"}}},
    {"Sid":"UseSessionLaunchNetworkAndKey","Effect":"Allow","Action":"ec2:RunInstances","Resource":["arn:aws:ec2:us-east-1:891376991548:subnet/*","arn:aws:ec2:us-east-1:891376991548:security-group/*","arn:aws:ec2:us-east-1:891376991548:key-pair/*"],"Condition":{"StringEquals":{"ec2:ResourceTag/Project":"readyspec-m4","ec2:ResourceTag/Session":"d6b321143e61d7bf2a6c6b5f"}}},
    {"Sid":"LaunchSmallSessionInstances","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:us-east-1:891376991548:instance/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"readyspec-m4","aws:RequestTag/Session":"d6b321143e61d7bf2a6c6b5f","ec2:InstanceType":["t3.small","t4g.small","t3.medium","t4g.medium","t3.xlarge"],"ec2:Tenancy":"default","ec2:InstanceMarketType":"on-demand","ec2:MetadataHttpTokens":"required","ec2:RootDeviceType":"ebs"},"Null":{"ec2:ProductCode":"true"}}},
    {"Sid":"LaunchBoundedEncryptedSessionVolumes","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:us-east-1:891376991548:volume/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"readyspec-m4","aws:RequestTag/Session":"d6b321143e61d7bf2a6c6b5f","ec2:VolumeType":"gp3"},"Bool":{"ec2:Encrypted":"true"},"NumericLessThanEquals":{"ec2:VolumeSize":"80","ec2:VolumeIops":"3000","ec2:VolumeThroughput":"125"}}},
    {"Sid":"LaunchPrivateValidationInterfaces","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:us-east-1:891376991548:network-interface/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"readyspec-m4","aws:RequestTag/Session":"d6b321143e61d7bf2a6c6b5f","aws:RequestTag/NetworkClass":"private-validation"},"Bool":{"ec2:AssociatePublicIpAddress":"false"}}},
    {"Sid":"LaunchPublicBootstrapInterfaces","Effect":"Allow","Action":"ec2:RunInstances","Resource":"arn:aws:ec2:us-east-1:891376991548:network-interface/*","Condition":{"StringEquals":{"aws:RequestTag/Project":"readyspec-m4","aws:RequestTag/Session":"d6b321143e61d7bf2a6c6b5f","aws:RequestTag/NetworkClass":"public-bootstrap"},"Bool":{"ec2:AssociatePublicIpAddress":"true"}}},
    {"Sid":"TagOnlyDuringResourceCreation","Effect":"Allow","Action":"ec2:CreateTags","Resource":["arn:aws:ec2:us-east-1:891376991548:vpc/*","arn:aws:ec2:us-east-1:891376991548:subnet/*","arn:aws:ec2:us-east-1:891376991548:route-table/*","arn:aws:ec2:us-east-1:891376991548:internet-gateway/*","arn:aws:ec2:us-east-1:891376991548:security-group/*","arn:aws:ec2:us-east-1:891376991548:key-pair/*","arn:aws:ec2:us-east-1:891376991548:instance/*","arn:aws:ec2:us-east-1:891376991548:volume/*","arn:aws:ec2:us-east-1:891376991548:network-interface/*","arn:aws:ec2:us-east-1::image/*","arn:aws:ec2:us-east-1::snapshot/*"],"Condition":{"StringEquals":{"ec2:CreateAction":["CreateVpc","CreateSubnet","CreateRouteTable","CreateInternetGateway","CreateSecurityGroup","ImportKeyPair","RunInstances","CreateImage","CreateSnapshot"],"aws:RequestTag/Project":"readyspec-m4","aws:RequestTag/Session":"d6b321143e61d7bf2a6c6b5f"},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","Session","Name","EnvID","ExpiresAt","NetworkClass","Variant"]}}},
    {"Sid":"ManageOnlySessionCompute","Effect":"Allow","Action":["ec2:StartInstances","ec2:StopInstances","ec2:RebootInstances","ec2:TerminateInstances","ec2:GetConsoleOutput","ec2:DescribeInstanceAttribute","ec2:DeleteVolume","ec2:DeleteNetworkInterface"],"Resource":["arn:aws:ec2:us-east-1:891376991548:instance/*","arn:aws:ec2:us-east-1:891376991548:volume/*","arn:aws:ec2:us-east-1:891376991548:network-interface/*"],"Condition":{"StringEquals":{"ec2:ResourceTag/Project":"readyspec-m4","ec2:ResourceTag/Session":"d6b321143e61d7bf2a6c6b5f"}}},
    {"Sid":"RemoveOwnedSessionImagesAndSnapshots","Effect":"Allow","Action":["ec2:DeregisterImage","ec2:DeleteSnapshot"],"Resource":["arn:aws:ec2:us-east-1::image/*","arn:aws:ec2:us-east-1::snapshot/*"],"Condition":{"StringEquals":{"ec2:Owner":"891376991548","ec2:ResourceTag/Project":"readyspec-m4","ec2:ResourceTag/Session":"d6b321143e61d7bf2a6c6b5f"}}}
  ]
}
