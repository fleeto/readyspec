{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ImportSessionPublicKey",
      "Effect": "Allow",
      "Action": "ec2:ImportKeyPair",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:key-pair/*",
      "Condition": {"StringEquals": {"aws:RequestTag/Project": "readyspec-m4", "aws:RequestTag/Session": "117f28ab8bdbd660bf43405d"}}
    },
    {
      "Sid": "RemoveSessionPublicKey",
      "Effect": "Allow",
      "Action": "ec2:DeleteKeyPair",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:key-pair/*",
      "Condition": {"StringEquals": {"ec2:ResourceTag/Project": "readyspec-m4", "ec2:ResourceTag/Session": "117f28ab8bdbd660bf43405d"}}
    },
    {
      "Sid": "UseSessionLaunchNetworkAndKey",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:us-east-1:891376991548:subnet/*", "arn:aws:ec2:us-east-1:891376991548:security-group/*", "arn:aws:ec2:us-east-1:891376991548:key-pair/*"],
      "Condition": {"StringEquals": {"ec2:ResourceTag/Project": "readyspec-m4", "ec2:ResourceTag/Session": "117f28ab8bdbd660bf43405d"}}
    },
    {
      "Sid": "LaunchSmallSessionInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "readyspec-m4", "aws:RequestTag/Session": "117f28ab8bdbd660bf43405d",
          "ec2:InstanceType": ["t3.small", "t4g.small", "t3.medium", "t4g.medium", "t3.xlarge"],
          "ec2:Tenancy": "default", "ec2:InstanceMarketType": "on-demand",
          "ec2:MetadataHttpTokens": "required", "ec2:RootDeviceType": "ebs"
        },
        "Null": {"ec2:ProductCode": "true"}
      }
    },
    {
      "Sid": "LaunchBoundedEncryptedSessionVolumes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:volume/*",
      "Condition": {
        "StringEquals": {"aws:RequestTag/Project": "readyspec-m4", "aws:RequestTag/Session": "117f28ab8bdbd660bf43405d", "ec2:VolumeType": "gp3"},
        "Bool": {"ec2:Encrypted": "true"},
        "NumericLessThanEquals": {"ec2:VolumeSize": "80", "ec2:VolumeIops": "3000", "ec2:VolumeThroughput": "125"}
      }
    },
    {
      "Sid": "LaunchPrivateValidationInterfaces",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:network-interface/*",
      "Condition": {
        "StringEquals": {"aws:RequestTag/Project": "readyspec-m4", "aws:RequestTag/Session": "117f28ab8bdbd660bf43405d", "aws:RequestTag/NetworkClass": "private-validation"},
        "Bool": {"ec2:AssociatePublicIpAddress": "false"}
      }
    },
    {
      "Sid": "LaunchPublicBootstrapInterfaces",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:network-interface/*",
      "Condition": {
        "StringEquals": {"aws:RequestTag/Project": "readyspec-m4", "aws:RequestTag/Session": "117f28ab8bdbd660bf43405d", "aws:RequestTag/NetworkClass": "public-bootstrap"},
        "Bool": {"ec2:AssociatePublicIpAddress": "true"}
      }
    },
    {
      "Sid": "ManageOnlySessionInstances",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances", "ec2:RebootInstances", "ec2:TerminateInstances", "ec2:GetConsoleOutput", "ec2:DescribeInstanceAttribute"],
      "Resource": "arn:aws:ec2:us-east-1:891376991548:instance/*",
      "Condition": {"StringEquals": {"ec2:ResourceTag/Project": "readyspec-m4", "ec2:ResourceTag/Session": "117f28ab8bdbd660bf43405d"}}
    },
    {
      "Sid": "RemoveOnlySessionVolumes",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:volume/*",
      "Condition": {"StringEquals": {"ec2:ResourceTag/Project": "readyspec-m4", "ec2:ResourceTag/Session": "117f28ab8bdbd660bf43405d"}}
    }
  ]
}
