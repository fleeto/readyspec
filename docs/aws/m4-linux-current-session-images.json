{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateImageFromSessionInstance",
      "Effect": "Allow",
      "Action": "ec2:CreateImage",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:instance/*",
      "Condition": {"StringEquals": {"ec2:ResourceTag/Project": "readyspec-m4", "ec2:ResourceTag/Session": "117f28ab8bdbd660bf43405d"}}
    },
    {
      "Sid": "CreateSnapshotFromSessionVolume",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": "arn:aws:ec2:us-east-1:891376991548:volume/*",
      "Condition": {"StringEquals": {"ec2:ResourceTag/Project": "readyspec-m4", "ec2:ResourceTag/Session": "117f28ab8bdbd660bf43405d"}}
    },
    {
      "Sid": "CreateTaggedSessionImagesAndSnapshots",
      "Effect": "Allow",
      "Action": ["ec2:CreateImage", "ec2:CreateSnapshot"],
      "Resource": ["arn:aws:ec2:us-east-1::image/*", "arn:aws:ec2:us-east-1::snapshot/*"],
      "Condition": {"StringEquals": {"aws:RequestTag/Project": "readyspec-m4", "aws:RequestTag/Session": "117f28ab8bdbd660bf43405d"}}
    },
    {
      "Sid": "UseOwnedSessionImagesAndSnapshots",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:us-east-1::image/*", "arn:aws:ec2:us-east-1::snapshot/*"],
      "Condition": {"StringEquals": {"ec2:Owner": "891376991548", "ec2:ResourceTag/Project": "readyspec-m4", "ec2:ResourceTag/Session": "117f28ab8bdbd660bf43405d"}}
    },
    {
      "Sid": "RemoveOwnedSessionImagesAndSnapshots",
      "Effect": "Allow",
      "Action": ["ec2:DeregisterImage", "ec2:DeleteSnapshot"],
      "Resource": ["arn:aws:ec2:us-east-1::image/*", "arn:aws:ec2:us-east-1::snapshot/*"],
      "Condition": {"StringEquals": {"ec2:Owner": "891376991548", "ec2:ResourceTag/Project": "readyspec-m4", "ec2:ResourceTag/Session": "117f28ab8bdbd660bf43405d"}}
    }
  ]
}
