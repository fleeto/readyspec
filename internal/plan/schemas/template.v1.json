{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyspec.dev/schemas/template.v1.json",
  "title": "ReadySpec CheckTemplate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "version", "name", "source", "domain", "execution_mode", "evidence_mode", "params_schema", "implementation", "digest"],
  "properties": {
    "schema_version": {"const": "readyspec.template/v1"},
    "template_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "maxLength": 128},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 2000},
    "source": {"enum": ["BUILTIN", "USER_PUBLIC", "PLAN_LOCAL"]},
    "domain": {"enum": ["H", "O", "S", "N", "R", "A", "D", "L"]},
    "execution_mode": {"enum": ["STANDARD", "PRIVILEGED"]},
    "evidence_mode": {"enum": ["EXISTENCE", "METADATA", "CONFIG", "EFFECTIVE_STATE", "STATIC_BINARY", "ACTIVE_PROBE", "LOG_HISTORY"]},
    "params_schema": {"type": "object"},
    "implementation": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["kind","compiler","compiler_version"],"properties":{"kind":{"const":"BUILTIN"},"compiler":{"type":"string","minLength":1},"compiler_version":{"type":"string","minLength":1},"requires":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},
        {"type":"object","additionalProperties":false,"required":["kind","command","expect_exit_code"],"properties":{"kind":{"const":"CUSTOM_SHELL"},"command":{"type":"string","minLength":1},"expect_exit_code":{"type":"integer","minimum":0,"maximum":255}}}
      ]
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "if": {"properties": {"source": {"enum": ["USER_PUBLIC", "PLAN_LOCAL"]}}},
  "then": {"properties": {"execution_mode": {"const": "STANDARD"}}}
}
